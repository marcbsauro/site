<script>
  // Progress bar + active nav highlight
  const sections = document.querySelectorAll('.slide-section');
  const topLinks = document.querySelectorAll('nav a');
  const botLinks = document.querySelectorAll('.mobile-nav a');
  const mobileNav = document.querySelector('.mobile-nav-inner');

  // Map href anchors to slide IDs
  function getIdFromHref(a) {
    return a.getAttribute('href').replace('#', '');
  }

  function updateNav() {
    const doc = document.documentElement;
    const scrolled = doc.scrollTop || document.body.scrollTop;
    const total = doc.scrollHeight - doc.clientHeight;

    // Progress bar
    document.getElementById('progress').style.width = (scrolled / total * 100) + '%';

    // Find active section (which section occupies most of the viewport)
    let activeId = null;
    const mid = scrolled + window.innerHeight / 2;
    sections.forEach(sec => {
      if (sec.offsetTop <= mid) activeId = sec.id;
    });

    // Update top nav
    topLinks.forEach(a => {
      const id = getIdFromHref(a);
      a.classList.toggle('active', id === activeId);
    });

    // Update bottom nav + auto-scroll active link into view
    botLinks.forEach(a => {
      const id = getIdFromHref(a);
      const isActive = id === activeId;
      a.classList.toggle('active', isActive);
      if (isActive && mobileNav) {
        // Scroll the mobile nav so the active link is visible near the left
        const linkLeft = a.offsetLeft;
        mobileNav.scrollTo({ left: Math.max(0, linkLeft - 16), behavior: 'smooth' });
      }
    });
  }

  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav(); // run once on load
</script>

