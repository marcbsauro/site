<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" type="image/svg+xml" href="talan.svg">
<title>Stratégie Data & IA — Talan | Marc B. Sauro</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --blue:    #2E71B5;
    --blue-lt: #4A8FD1;
    --magenta: #D52576;
    --olive:   #818E24;
    --navy:    #12283F;
    --navy2:   #1B3B5C;
    --white:   #FFFFFF;
    --off:     #F5F8FD;
    --text:    #12283F;
    --muted:   #5B6B7D;
    --dim:     #97A5B0;
    --line:    #DDE4ED;
    --font:    Arial, sans-serif;
  }
  html { scroll-behavior: smooth; }
  body { font-family: var(--font); background: var(--off); color: var(--text); line-height: 1.6; }

  /* Header */
  header {
    position: sticky; top: 0; z-index: 100;
    background: var(--navy);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 2.5rem; height: 56px;
    border-bottom: 2px solid var(--blue);
  }
  .header-brand { display: flex; align-items: center; gap: 0.75rem; }
  .header-logo { font-size: 1rem; font-weight: 700; letter-spacing: 0.12em; color: var(--white); }
  .header-logo span { color: var(--blue); }
  .header-tagline { font-size: 0.7rem; letter-spacing: 0.08em; color: var(--dim); text-transform: uppercase; }
  nav { display: flex; gap: 0.25rem; }
  nav a {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em;
    color: var(--dim); text-decoration: none;
    padding: 0.3rem 0.55rem; border-radius: 3px;
    transition: color 0.15s, background 0.15s;
  }
  nav a:hover { color: var(--white); background: var(--navy2); }

  /* Progress */
  .progress-bar { position: fixed; top: 56px; left: 0; right: 0; height: 3px; z-index: 99; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--blue), var(--magenta)); transition: width 0.1s linear; }

  /* Hero */
  .hero {
    background: var(--navy); padding: 5rem 2.5rem 4rem; text-align: center;
    border-bottom: 1px solid var(--navy2);
  }
  .hero-eyebrow { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; color: var(--blue); text-transform: uppercase; margin-bottom: 1.25rem; }
  .hero h1 { font-size: clamp(1.9rem, 4vw, 3rem); font-weight: 700; color: var(--white); line-height: 1.15; margin-bottom: 1.25rem; max-width: 780px; margin-left: auto; margin-right: auto; }
  .hero h1 em { font-style: normal; color: var(--blue); }
  .hero-sub { font-size: 1rem; color: #7A9BBF; max-width: 520px; margin: 0 auto 2.5rem; }
  .hero-pills { display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; }
  .pill { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.35rem 0.9rem; border-radius: 20px; border: 1px solid; }
  .pill-blue  { color: var(--blue);    border-color: var(--blue);    background: rgba(46,113,181,0.12); }
  .pill-mag   { color: var(--magenta); border-color: var(--magenta); background: rgba(213,37,118,0.10); }
  .pill-olive { color: #A8B830;        border-color: #818E24;        background: rgba(129,142,36,0.12); }

  /* Sections */
  .slide-section { padding: 4rem 0; border-bottom: 1px solid var(--line); }
  .slide-section:last-of-type { border-bottom: none; }
  .section-dark  { background: var(--navy); }
  .section-light { background: var(--white); }
  .section-light:nth-of-type(even) { background: var(--off); }
  .slide-inner { max-width: 900px; margin: 0 auto; padding: 0 2rem; }

  .slide-meta { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; }
  .slide-num { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; color: var(--white); background: var(--blue); padding: 0.25rem 0.6rem; border-radius: 3px; }
  .slide-eyebrow { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); }

  .slide-visual { width: 100%; border-radius: 8px; overflow: hidden; margin-bottom: 2rem; box-shadow: 0 4px 24px rgba(18,40,63,0.18); border: 1px solid rgba(46,113,181,0.15); }
  .slide-visual img { width: 100%; display: block; }

  .slide-title { font-size: clamp(1.3rem, 2.8vw, 1.85rem); font-weight: 700; line-height: 1.2; margin-bottom: 0.6rem; }
  .section-dark  .slide-title { color: var(--white); }
  .section-light .slide-title { color: var(--navy); }

  .slide-sub { font-size: 0.85rem; letter-spacing: 0.04em; margin-bottom: 2rem; }
  .section-dark  .slide-sub { color: #7A9BBF; }
  .section-light .slide-sub { color: var(--muted); }

  /* Notes */
  .slide-notes { border-left: 3px solid var(--blue); padding-left: 1.5rem; margin-top: 0.5rem; }
  .section-dark .slide-notes { border-left-color: var(--magenta); }
  .notes-label { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 0.9rem; }
  .section-dark  .notes-label { color: var(--magenta); }
  .section-light .notes-label { color: var(--blue); }
  .notes-content p { font-size: 0.95rem; line-height: 1.8; margin-bottom: 0.85rem; }
  .notes-content p:last-child { margin-bottom: 0; }
  .section-dark  .notes-content p { color: #A8C0D6; }
  .section-light .notes-content p { color: var(--muted); }

  /* Footer */
  footer { background: var(--navy); padding: 2.5rem; text-align: center; border-top: 1px solid var(--navy2); }
  .footer-brand { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; color: var(--dim); text-transform: uppercase; margin-bottom: 0.4rem; }
  .footer-brand span { color: var(--blue); }
  .footer-note { font-size: 0.68rem; color: #3D5570; }

  /* Mobile bottom nav */
  .mobile-nav {
    display: none;
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 100;
    background: var(--navy);
    border-top: 1px solid var(--navy2);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .mobile-nav::-webkit-scrollbar { display: none; }
  .mobile-nav-inner {
    display: flex;
    align-items: center;
    padding: 0 0.75rem;
    height: 48px;
    white-space: nowrap;
    min-width: max-content;
  }
  .mobile-nav a {
    font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em;
    color: var(--dim); text-decoration: none; text-transform: uppercase;
    padding: 0 0.75rem; height: 48px;
    display: inline-flex; align-items: center;
    transition: color 0.15s;
    flex-shrink: 0;
    border-bottom: 2px solid transparent;
  }
  .mobile-nav a.active {
    color: var(--white);
    border-bottom-color: var(--blue);
  }

  /* Top nav active */
  nav a.active {
    color: var(--white);
    background: var(--navy2);
  }

  @media (max-width: 640px) {
    header { padding: 0 1.25rem; }
    nav { display: none; }
    .hero { padding: 3rem 1.25rem 2.5rem; }
    .slide-inner { padding: 0 1.25rem; }
    .slide-section { padding: 2.5rem 0; }
    .mobile-nav { display: block; }
    body { padding-bottom: 48px; }
  }
</style>
</head>
